RESOURCES = [
    {
        "uri": "systemsentinel://state",
        "name": "SystemSentinel State",
        "description": "Estado atual completo do SystemSentinel (métricas, incidentes, status de voz e processos).",
        "mimeType": "application/json"
    },
    {
        "uri": "systemsentinel://events",
        "name": "SystemSentinel Event Log",
        "description": "Registro de eventos e auditoria em JSON Lines do SystemSentinel.",
        "mimeType": "application/x-jsonlines"
    }
]


def handle_tool_call(name: str, arguments: dict) -> dict:
    # 1. get_system_metrics
    if name == "get_system_metrics":
        sock_res = query_sentinel_socket({"action": "get_state"})
        if sock_res and "metrics" in sock_res:
            data = sock_res["metrics"]
            data["appStatus"] = "SystemSentinel GUI Ativo"
            data["isVoiceMuted"] = sock_res.get("isVoiceMuted", False)
            data["isSpeaking"] = sock_res.get("isSpeaking", False)
        else:
            cached = read_cached_state()
            if cached.get("metrics"):
                data = cached["metrics"]
                data["appStatus"] = "SystemSentinel (Cache / Background)"
            else:
                data = get_fallback_system_metrics()
                data["appStatus"] = "Standalone / macOS Direct"
        return {"content": [{"type": "text", "text": json.dumps(data, indent=2, ensure_ascii=False)}]}

    # 2. get_active_incidents
    if name == "get_active_incidents":
        sock_res = query_sentinel_socket({"action": "get_state"})
        if sock_res and "activeIncidents" in sock_res:
            incidents = sock_res["activeIncidents"]
        else:
            cached = read_cached_state()
            incidents = cached.get("activeIncidents", [])
        return {"content": [{"type": "text", "text": json.dumps({"activeIncidents": incidents, "count": len(incidents)}, indent=2, ensure_ascii=False)}]}

    # 3. get_system_events
    if name == "get_system_events":
        limit = arguments.get("limit", 30)
        sock_res = query_sentinel_socket({"action": "get_events", "limit": limit})
        if sock_res and "events" in sock_res:
            events = sock_res["events"]
        else:
            events = read_recent_events(limit)
        return {"content": [{"type": "text", "text": json.dumps({"events": events, "count": len(events)}, indent=2, ensure_ascii=False)}]}

    # 4. list_processes
    if name == "list_processes":
        sort_by = arguments.get("sortBy", "cpu")
        limit = arguments.get("limit", 15)
        flt = arguments.get("filter")
        sock_res = query_sentinel_socket({"action": "get_processes", "sortBy": sort_by, "limit": limit, "filter": flt})
        if sock_res and "processes" in sock_res:
            procs = sock_res["processes"]
        else:
            cached = read_cached_state()
            procs = cached.get("topProcesses", [])
            if flt:
                procs = [p for p in procs if flt.lower() in p.get("name", "").lower()]
            procs = procs[:limit]
        return {"content": [{"type": "text", "text": json.dumps({"processes": procs, "count": len(procs)}, indent=2, ensure_ascii=False)}]}

    # 5. resolve_incident
    if name == "resolve_incident":
        inc_id = arguments.get("incidentId")
        execute = arguments.get("executeAction", False)
        sock_res = query_sentinel_socket({"action": "resolve_incident", "id": inc_id, "executeAction": execute})
        if sock_res:
            return {"content": [{"type": "text", "text": json.dumps(sock_res, indent=2, ensure_ascii=False)}]}
        return {"content": [{"type": "text", "text": json.dumps({"status": "warning", "message": "SystemSentinel app não conectado via socket; certifique-se de que o app esteja aberto."}, ensure_ascii=False)}]}

    # 6. manage_process
    if name == "manage_process":
        pid = arguments.get("pid")
        sig = arguments.get("signal", "kill")
        sock_res = query_sentinel_socket({"action": "manage_process", "pid": pid, "signal": sig})
        if sock_res:
            return {"content": [{"type": "text", "text": json.dumps(sock_res, indent=2, ensure_ascii=False)}]}
        # Fallback local
        try:
            if sig == "kill":
                os.kill(pid, 9)
                return {"content": [{"type": "text", "text": json.dumps({"status": "ok", "pid": pid, "action": "SIGKILL enviado diretamente"}, ensure_ascii=False)}]}
            else:
                return {"content": [{"type": "text", "text": json.dumps({"status": "error", "message": "Restart de processo exige SystemSentinel app ativo."}, ensure_ascii=False)}]}
        except Exception as e:
            return {"isError": True, "content": [{"type": "text", "text": f"Falha ao executar ação no PID {pid}: {str(e)}"}]}

    # 7. set_voice_mute
    if name == "set_voice_mute":
        muted = arguments.get("muted")
        stop_now = arguments.get("stopAudioNow", False)

        results = {}
        if stop_now:
            sock_res = query_sentinel_socket({"action": "stop_audio"})
            if not sock_res:
                stop_audio_players()
            results["stoppedAudio"] = True

        if muted is not None:
            sock_res = query_sentinel_socket({"action": "set_voice_mute", "muted": muted})
            if sock_res:
                results["isVoiceMuted"] = sock_res.get("isVoiceMuted", muted)
            else:
                results["isVoiceMuted"] = muted
                results["note"] = "Atualizado localmente; sincronizará quando o SystemSentinel abrir."

        return {"content": [{"type": "text", "text": json.dumps({"status": "ok", **results}, indent=2, ensure_ascii=False)}]}

    # 8. open_settings
    if name == "open_settings":
        open_val = arguments.get("open", True)
        act = "open_settings" if open_val else "close_settings"
        sock_res = query_sentinel_socket({"action": act})
        if sock_res:
            return {"content": [{"type": "text", "text": json.dumps(sock_res, indent=2, ensure_ascii=False)}]}
        return {"content": [{"type": "text", "text": json.dumps({"status": "warning", "message": "SystemSentinel app não conectado via socket."}, ensure_ascii=False)}]}

    # 9. speak_message
    if name == "speak_message":
        message = arguments.get("message", "")
        sock_res = query_sentinel_socket({"action": "speak", "message": message})
        if sock_res and sock_res.get("status") == "ok":
            return {"content": [{"type": "text", "text": json.dumps({"status": "ok", "spokenVia": "SystemSentinel App", "message": message}, ensure_ascii=False)}]}
        
        ok = execute_falar(message)
        return {"content": [{"type": "text", "text": json.dumps({"status": "ok" if ok else "error", "spokenVia": "CLI falar fallback", "message": message}, ensure_ascii=False)}]}

    return {"isError": True, "content": [{"type": "text", "text": f"Ferramenta desconhecida: {name}"}]}


def handle_resource_read(uri: str) -> dict:
    if uri == "systemsentinel://state":
        sock_res = query_sentinel_socket({"action": "get_state"})
        content = sock_res if sock_res else read_cached_state()
        return {
            "contents": [{
                "uri": uri,
                "mimeType": "application/json",
                "text": json.dumps(content, indent=2, ensure_ascii=False)
            }]
        }
    elif uri == "systemsentinel://events":
        if EVENTS_PATH.exists():
            text = EVENTS_PATH.read_text(encoding="utf-8")
        else:
            text = ""
        return {
            "contents": [{
                "uri": uri,
                "mimeType": "application/x-jsonlines",
                "text": text
            }]
        }
    return {"error": {"code": -32602, "message": f"Recurso não encontrado: {uri}"}}


def main():
    while True:
        try:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue

            # Suporte para Content-Length framing se enviado
            if line.startswith("Content-Length:"):
                length = int(line.split(":")[1].strip())
                # consome linha em branco
                sys.stdin.readline()
                raw_body = sys.stdin.read(length)
                req = json.loads(raw_body)
            else:
                req = json.loads(line)

            req_id = req.get("id")
            method = req.get("method")
            params = req.get("params", {})

            if method == "initialize":
                res = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "capabilities": {
                            "tools": {},
                            "resources": {}
                        },
                        "serverInfo": {
                            "name": "systemsentinel",
                            "version": "1.0.0"
                        }
                    }
                }
            elif method == "notifications/initialized" or method == "initialized":
                # Notificação, sem resposta
                continue
            elif method == "ping":
                res = {"jsonrpc": "2.0", "id": req_id, "result": {}}
            elif method == "tools/list":
                res = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "tools": TOOLS
                    }
                }
            elif method == "tools/call":
                tool_name = params.get("name")
                tool_args = params.get("arguments", {})
                tool_result = handle_tool_call(tool_name, tool_args)
                res = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": tool_result
                }
            elif method == "resources/list":
                res = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "resources": RESOURCES
                    }
                }
            elif method == "resources/read":
                uri = params.get("uri")
                res_content = handle_resource_read(uri)
                if "error" in res_content:
                    res = {"jsonrpc": "2.0", "id": req_id, "error": res_content["error"]}
                else:
                    res = {"jsonrpc": "2.0", "id": req_id, "result": res_content}
            else:
                res = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {
                        "code": -32601,
                        "message": f"Método não encontrado: {method}"
                    }
                }

            out = json.dumps(res, ensure_ascii=False)
            sys.stdout.write(out + "\n")
            sys.stdout.flush()

        except (KeyboardInterrupt, SystemExit):
            break
        except Exception as e:
            err_res = {
                "jsonrpc": "2.0",
                "id": req.get("id") if "req" in locals() and isinstance(req, dict) else None,
                "error": {
                    "code": -32603,
                    "message": str(e)
                }
            }
            sys.stdout.write(json.dumps(err_res) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
