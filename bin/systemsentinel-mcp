#!/usr/bin/env python3
"""
SystemSentinel MCP Server
Model Context Protocol (JSON-RPC 2.0 stdio) for sharing SystemSentinel telemetry,
events, proactive guardian incidents, process management, and voice controls with AI agents.
"""

import sys
import os
import json
import socket
import subprocess
import time
from pathlib import Path

SENTINEL_DIR = Path.home() / ".systemsentinel"
SOCKET_PATH = SENTINEL_DIR / "sentinel.sock"
STATE_PATH = SENTINEL_DIR / "state.json"
EVENTS_PATH = SENTINEL_DIR / "events.jsonl"


def query_sentinel_socket(payload: dict, timeout: float = 1.0) -> dict | None:
    """Sends a command to the running SystemSentinel app via Unix domain socket."""
    if not SOCKET_PATH.exists():
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(str(SOCKET_PATH))
        data = json.dumps(payload).encode("utf-8")
        s.sendall(data)
        s.shutdown(socket.SHUT_WR)
        
        chunks = []
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            chunks.append(chunk)
        s.close()
        raw = b"".join(chunks).decode("utf-8", errors="replace")
        return json.loads(raw) if raw else None
    except Exception:
        return None


def get_fallback_system_metrics() -> dict:
    """Collects system metrics directly if SystemSentinel app is not running."""
    metrics = {
        "cpuUsage": 0.0,
        "loadAverage": 0.0,
        "memoryUsagePercent": 0.0,
        "memoryUsedGB": 0.0,
        "memoryTotalGB": 0.0,
        "swapUsedGB": 0.0,
        "statusTitle": "Normal"
    }

    # Load average via os.getloadavg()
    try:
        load1, load5, load15 = os.getloadavg()
        metrics["loadAverage"] = round(load1, 2)
        metrics["load15"] = round(load15, 2)
    except Exception:
        pass

    # Total RAM via sysctl
    try:
        res = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True)
        if res.returncode == 0:
            mem_bytes = int(res.stdout.strip())
            metrics["memoryTotalGB"] = round(mem_bytes / (1024 ** 3), 2)
    except Exception:
        pass

    # Memory used via vm_stat
    try:
        res = subprocess.run(["vm_stat"], capture_output=True, text=True)
        if res.returncode == 0:
            lines = res.stdout.splitlines()
            page_size = 4096
            for line in lines:
                if "page size of" in line:
                    parts = line.split("page size of")
                    if len(parts) > 1:
                        page_size = int(parts[1].split()[0])
            pages_active = 0
            pages_wired = 0
            pages_compressed = 0
            for line in lines:
                if "Pages active:" in line:
                    pages_active = int(line.split(":")[1].strip().rstrip("."))
                elif "Pages wired down:" in line:
                    pages_wired = int(line.split(":")[1].strip().rstrip("."))
                elif "Pages occupied by compressor:" in line:
                    pages_compressed = int(line.split(":")[1].strip().rstrip("."))
            used_bytes = (pages_active + pages_wired + pages_compressed) * page_size
            metrics["memoryUsedGB"] = round(used_bytes / (1024 ** 3), 2)
            if metrics["memoryTotalGB"] > 0:
                metrics["memoryUsagePercent"] = round((metrics["memoryUsedGB"] / metrics["memoryTotalGB"]) * 100, 1)
    except Exception:
        pass

    # Quick CPU sample via top
    try:
        res = subprocess.run(["top", "-l", "1", "-n", "0"], capture_output=True, text=True, timeout=2.0)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "CPU usage:" in line:
                    # CPU usage: 12.5% user, 8.2% sys, 79.3% idle
                    parts = line.split("CPU usage:")[1].split(",")
                    user_str = parts[0].replace("user", "").replace("%", "").strip()
                    sys_str = parts[1].replace("sys", "").replace("%", "").strip() if len(parts) > 1 else "0"
                    metrics["cpuUsage"] = round(float(user_str) + float(sys_str), 1)
                    break
    except Exception:
        pass

    if metrics["cpuUsage"] >= 90 or metrics["memoryUsagePercent"] >= 90:
        metrics["statusTitle"] = "Crítico"
    elif metrics["cpuUsage"] >= 70 or metrics["memoryUsagePercent"] >= 75:
        metrics["statusTitle"] = "Atenção"

    return metrics


def read_cached_state() -> dict:
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {}


def read_recent_events(limit: int = 30) -> list:
    if not EVENTS_PATH.exists():
        return []
    try:
        lines = EVENTS_PATH.read_text(encoding="utf-8").splitlines()
        events = []
        for line in reversed(lines):
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line))
                if len(events) >= limit:
                    break
            except Exception:
                continue
        return events
    except Exception:
        return []


def execute_falar(message: str) -> bool:
    falar_paths = [
        str(Path.home() / "bin/falar"),
        str(Path.home() / ".local/bin/falar"),
        "/opt/homebrew/bin/falar",
        "/usr/local/bin/falar"
    ]
    exe = next((p for p in falar_paths if os.path.isfile(p) and os.access(p, os.X_OK)), None)
    if exe:
        cmd = [exe, "--interrupt", "--project", "SystemSentinel", "--context", "Agente Externo", message]
    else:
        cmd = ["/usr/bin/say", "-v", "Luciana", message]
    
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception:
        return False


def stop_audio_players():
    try:
        subprocess.run(["/usr/bin/pkill", "-f", "ffplay.*-nodisp|afplay.*falar|afplay.*kokoro|afplay.*easyvoice"], check=False)
        subprocess.run(["/usr/bin/killall", "say"], check=False)
    except Exception:
        pass


# ==============================================================================
# MCP Protocol Handlers
# ==============================================================================

